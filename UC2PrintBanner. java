/**
 * UC2PrintBanner – ASCII Banner Display Application
 * This class renders the "OOPS" banner using 7 lines of asterisks.
 * @author Divyansh Sanadhya
 * @version 2.0
 */
public class UC2PrintBanner {
    public static void main(String[] args) {
        // Constructing the "OOPS" banner using concatenation (+) for each line
        System.out.println("  ***** " + "  ***** " + " ******* " + "  ****** ");
        System.out.println(" ** ** " + " ** ** " + " ** ** " + " ** ");
        System.out.println(" ** ** " + " ** ** " + " ** ** " + " ** ");
        System.out.println(" ** ** " + " ** ** " + " ******* " + "  ***** ");
        System.out.println(" ** ** " + " ** ** " + " ** " + "      **");
        System.out.println(" ** ** " + " ** ** " + " ** " + "      **");
        System.out.println("  ***** " + "  ***** " + " ** " + " ****** ");
    }
}